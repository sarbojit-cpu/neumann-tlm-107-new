# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ---- Remotion project ----
# Bundler output and QA stills are regenerated; don't commit them.
/build/
/qa/
/qa-longform/
.remotion/
# The reel's final MP4 (out/video.mp4) is committed since it fits under
# GitHub's 100MB per-file limit. Thumbnails are also committed.
# The long-form MP4 (out/video-longform.mp4) is expected to exceed 100MB at
# ~600s — it is delivered separately (not committed) rather than via git.
/out/*.mov
/out/video-longform.mp4
