{
  "name": "neumann-tlm-107-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Neumann TLM 107 Studio Set — 178s vertical product reel (Remotion). Offered by Shivansh Electronics.",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "bundle": "remotion bundle",
    "make-audio": "node scripts/make-audio.mjs",
    "make-audio:longform": "node scripts/make-audio-longform.mjs",
    "make-assets": "node scripts/copy-assets.mjs",
    "setup": "npm run make-audio && npm run make-audio:longform",
    "still": "remotion still",
    "render": "remotion render MainReel out/video.mp4 --concurrency=2",
    "render:longform": "remotion render LongForm out/video-longform.mp4 --concurrency=4",
    "render:thumb": "remotion still Thumbnail out/thumbnail.png"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@remotion/bundler": "4.0.497",
    "@remotion/cli": "4.0.497",
    "@remotion/media-utils": "4.0.497",
    "@remotion/renderer": "4.0.497",
    "@remotion/shapes": "4.0.497",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.497"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
